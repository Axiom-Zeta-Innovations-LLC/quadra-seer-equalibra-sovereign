[Unit]
Description=Atlantean Intelligence Backend (Vault)
Documentation=https://github.com/anthonyrenecastro-create/quadra-seer-equalibra-sovereign
After=network.target redis.service ollama.service
Wants=redis.service

[Service]
Type=simple
User=vault
Group=vault
WorkingDirectory=/opt/vault/studious-enigma-main
EnvironmentFile=/etc/vault/atlantean.env

ExecStart=/opt/vault/venv/bin/python atlantean_backend.py
ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

# Resource limits
MemoryMax=6G
CPUQuota=300%
TasksMax=256
LimitNOFILE=4096

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/vault /var/lib/vault
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
PrivateDevices=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=atlantean-backend

[Install]
WantedBy=multi-user.target
