# =========================
# Core backend configuration
# =========================

# Optional Gemini key used only when cloud escalation is explicitly enabled.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Local-first provider controls.
ATLANTEAN_LLM_PROVIDER=local
LOCAL_LLM_BACKEND=ollama
LOCAL_LLM_URL=http://127.0.0.1:11434/api/generate
LOCAL_LLM_MODEL=llama3.1:8b-instruct-q4_K_M
LOCAL_LLM_TIMEOUT_SECONDS=90

# Alternate local endpoints:
# llama.cpp server: LOCAL_LLM_BACKEND=llama.cpp, LOCAL_LLM_URL=http://127.0.0.1:8080/completion
# vLLM server: LOCAL_LLM_BACKEND=vllm, LOCAL_LLM_URL=http://127.0.0.1:8000/v1/completions

# Sovereignty controls (secure defaults).
ALLOW_OUTBOUND_NETWORK=0
ALLOW_CLOUD_ESCALATION=0
REQUIRE_CLOUD_ESCALATION_CONSENT=1

# At-rest encryption for persisted memory artifacts (Step 13).
# Generate key material with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ATLANTEAN_ENCRYPTION_ENABLED=1
ATLANTEAN_ENCRYPTION_KEYS_JSON={"v1":"REPLACE_WITH_FERNET_KEY"}
ATLANTEAN_ENCRYPTION_ACTIVE_KEY_ID=v1

# Step 15 ledger signature verification gates.
ATLANTEAN_VERIFY_LEDGER_ON_RESTORE=1
ATLANTEAN_VERIFY_LEDGER_ON_SYNC_MERGE=1

# Step 16 snapshot tamper-evidence gate.
ATLANTEAN_VERIFY_SNAPSHOT_TAMPER_EVIDENCE=1

# Step 17 corruption-recovery path gate.
ATLANTEAN_ENABLE_CORRUPTION_RECOVERY_REPAIR=1

# Step 18 memory-class retention controls.
ATLANTEAN_ENABLE_MEMORY_RETENTION_CONTROLS=1
ATLANTEAN_RETENTION_CHAT_TURNS_MAX=400
ATLANTEAN_RETENTION_SIMULATIONS_MAX=200
ATLANTEAN_RETENTION_TELEMETRY_EVENTS_MAX=2000

# Step 31 — local offline STT (faster-whisper) and TTS (Piper).
# Whisper model sizes: tiny, base, small, medium, large-v3
# Vault hardware recommendation: base (CPU) or small (with 6+ GB VRAM)
ATLANTEAN_WHISPER_MODEL=base
ATLANTEAN_WHISPER_DEVICE=cpu
ATLANTEAN_WHISPER_COMPUTE_TYPE=int8
# Force language detection (leave blank for auto-detect):
# ATLANTEAN_WHISPER_LANGUAGE=en
# Piper voice to use for TTS (must have .onnx + .onnx.json in PIPER_VOICE_DIR)
ATLANTEAN_PIPER_VOICE=en_US-lessac-medium
ATLANTEAN_PIPER_VOICE_DIR=./voices

# =========================
# Runtime security (Step 32 — Vault hardening)
# =========================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Required when running the backend on non-loopback interfaces or in Docker.
ATLANTEAN_API_TOKEN=
# Frontend must match: VITE_API_TOKEN=<same value as ATLANTEAN_API_TOKEN>
VITE_API_TOKEN=
# Bind address: 127.0.0.1 for Vault (loopback), 0.0.0.0 for Docker/LAN
ATLANTEAN_BIND_HOST=127.0.0.1
ATLANTEAN_PORT=5001
# Piper voice model checksums (optional — generates on first install):
# ATLANTEAN_MODEL_CHECKSUMS_JSON={"piper":{"en_US-lessac-medium.onnx":"<sha256>"}}

# Step 21 multi-cycle reasoning budgets by query class.
ATLANTEAN_ENABLE_QUERY_CLASS_REASONING_BUDGETS=1
ATLANTEAN_REASONING_CYCLES_SIMPLE=0
ATLANTEAN_REASONING_CYCLES_ANALYTICAL=1
ATLANTEAN_REASONING_CYCLES_DEEP=2
ATLANTEAN_REASONING_CYCLES_FILE_ASSISTED=2

# Step 23 HRM/RCM compute budget allocator.
ATLANTEAN_ENABLE_HRM_COMPUTE_BUDGET=1
ATLANTEAN_HRM_MAX_MS_PER_QUERY=20.0
ATLANTEAN_RCM_MAX_MS_PER_QUERY=20.0
ATLANTEAN_HRM_MAX_MS_PER_WINDOW=200.0
ATLANTEAN_HRM_COMPUTE_WINDOW_SECONDS=60

# Step 24 dynamic model tier selection.
# Leave blank to use LOCAL_LLM_MODEL for all tiers (single-model setup).
ATLANTEAN_MODEL_TIER_LIGHT=
ATLANTEAN_MODEL_TIER_STANDARD=
ATLANTEAN_MODEL_TIER_HEAVY=
ATLANTEAN_MODEL_TIER_PRESSURE_THRESHOLD=0.8

# Step 29 hardware scaling tier.
# Choices: small_quantized | medium | multi_agent
# Sets recommended compute/model/reasoning defaults for the detected hardware class.
ATLANTEAN_HARDWARE_TIER=medium

# Frontend provider hint (sent to backend adapter).
VITE_LLM_PROVIDER=local
VITE_CLOUD_ESCALATION_CONSENT=0

# Flask session security.
# Must be set to a unique random value in every deployment.
ATLANTEAN_SESSION_SECRET=
SESSION_COOKIE_SECURE=0

# Comma-separated CORS allowlist for backend APIs.
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5173,http://127.0.0.1:5173

# Redis host for primary low-latency persistence.
REDIS_HOST=localhost
