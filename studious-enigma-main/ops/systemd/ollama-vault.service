[Unit]
Description=Ollama LLM Server (Vault override)
After=network.target

[Service]
Type=simple
User=vault
Group=vault
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=/opt/vault/ollama-models

ExecStart=/usr/local/bin/ollama serve
Restart=on-failure
RestartSec=5

MemoryMax=20G
CPUQuota=400%
TasksMax=512

NoNewPrivileges=yes
PrivateTmp=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ollama-vault

[Install]
WantedBy=multi-user.target
