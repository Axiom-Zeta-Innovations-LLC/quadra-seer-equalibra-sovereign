# Deployment secrets for the Docker stack (scripts/stack.sh can generate this
# file for you as .env.local / .env.vps — values below are placeholders).
# NEVER commit a filled-in copy.

# API token the frontend bundle and backend share. One long random value;
# generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
ATLANTEAN_API_TOKEN=
# Must be identical to ATLANTEAN_API_TOKEN (baked into the frontend at build).
VITE_API_TOKEN=
# Flask session secret. Use a DIFFERENT random value than the API token.
ATLANTEAN_SESSION_SECRET=

# VPS mode only: public hostname served by your TLS reverse proxy.
SEER_DOMAIN=seer.example.com

# Optional overrides (defaults live in docker-compose.yml):
# LOCAL_LLM_MODEL=llama3.1:8b-instruct-q4_K_M
# LOCAL_LLM_URL=http://host.docker.internal:11434/api/generate
# GEMINI_API_KEY=            # only used if cloud escalation is enabled + consented
